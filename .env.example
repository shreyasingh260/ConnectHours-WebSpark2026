# Demo session signing secret. Use a long random value in any deployed environment.
SESSION_SECRET=replace-with-a-long-random-secret

# Optional production migration target. The current hackathon build uses local SQLite
# so it can start without external credentials. See supabase/schema.sql for the
# PostgreSQL schema and README.md for the migration path.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
